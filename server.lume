// server.lume — lume-core HTTP service: /api/features + /api/algorithms +
// /api/apps + static serving of web/dist (frontend build output). Uses the
// lume-core builtin server{} + run():
//
//   run:   bin/lume-core server.lume     (cwd = repo root)
//   check: curl http://127.0.0.1:18793/api/health
//
// Frontend dev mode (Vite :5173) proxies /api -> 127.0.0.1:18793; production
// uses docroot.

import "./src/features.lume" as feats;
import "./src/algorithms.lume" as algos;
import "./src/agent.lume" as agent;

// ---- public application catalog (neutral · no industry/proprietary info) ----
func apps() {
  let out = [];
  out = push(out, { name: "HTTP API / Web service", desc: "builtin server{} + run() · docroot static serving · SSE · route closures", libs: "lume-core builtin", status: "ok" });
  out = push(out, { name: "scientific computing CLI", desc: "numerical integration/interp/linear solve/eigenvalues (sci · linalg libs)", libs: "sci.lume, linalg.lume", status: "ok" });
  out = push(out, { name: "ML training & inference", desc: "MLP/attention/clustering/dimensionality · pure .lume training loops (ml lib)", libs: "ml.lume", status: "ok" });
  out = push(out, { name: "PINN solver", desc: "physics-constrained neural solving · analytic gradient (wall 1 · 200x)", libs: "pinn.lume", status: "ok" });
  out = push(out, { name: "PDE numerical solver", desc: "finite difference · heat/wave (pde lib)", libs: "pde.lume", status: "ok" });
  out = push(out, { name: "data pipeline / batch", desc: "map/filter/reduce · list reference semantics · file builtins", libs: "lume builtin", status: "ok" });
  out = push(out, { name: "static site + API in one process", desc: "docroot static + route API · single binary process", libs: "server{}", status: "ok" });
  out = push(out, { name: "MCP server", desc: "mcp_fs / mcp_math precedent · Model Context Protocol", libs: "lume-core builtin", status: "ok" });
  out = push(out, { name: "graph / signal / statistics tools", desc: "graph traversal · signal smoothing · distribution divergence (graph · sig · dist libs)", libs: "graph.lume, sig.lume, dist.lume", status: "ok" });
  out = push(out, { name: "SQLite data storage", desc: "sql_query builtin · structured queries", libs: "lume-core builtin", status: "ok" });
  out = push(out, { name: "crypto / hash tools", desc: "crypt_sha512 · hmac_sha256 · spawn subprocess", libs: "lume-core builtin", status: "ok" });
  out = push(out, { name: "optimization / operations research", desc: "gradient descent/Newton/line search (optim lib)", libs: "optim.lume", status: "ok" });
  return out;
}

// ---- performance comparison (lume-core measured · wall 1/2/3 · neutral data) ----
func bench() {
  let out = [];
  out = push(out, { name: "wall 1 · PINN analytic gradient", from: "4.5 min (numeric)", to: "1.3 s (analytic)", speedup: 207, note: "training · compiled backends · loss 0.573 -> 0.00224 · rel L2 1.43%" });
  out = push(out, { name: "wall 2 · codegen vs C", from: "1.00x (C)", to: "1.02x (lume)", speedup: 1.02, note: "scalar loop · codegen reaches C speed" });
  out = push(out, { name: "wall 3 · blas C kernel", from: "0.60 s (pure lume)", to: "0.05 s (C kernel)", speedup: 12, note: "128x128 · 30 runs · bit-identical" });
  return out;
}

func json(s: string) {
  return { status: 200, type: "application/json", body: s };
}

get "/api/health", (req) => {
  return json(stringify({ ok: true, service: "lume-showcase", cores: 1 }));
};

get "/api/features", (req) => {
  return json(stringify(feats.feature_list()));
};

get "/api/algorithms", (req) => {
  return json(stringify(algos.algorithm_list()));
};

get "/api/apps", (req) => {
  return json(stringify(apps()));
};

get "/api/agent", (req) => {
  return json(stringify(agent.agent_list()));
};

get "/api/bench", (req) => {
  return json(stringify(bench()));
};

// Bind address defaults to 127.0.0.1 (local-safe); override for container or
// cross-host access with LUME_BIND=0.0.0.0.
let bind_host: string = "127.0.0.1";
let bind_env = env("LUME_BIND");
if (bind_env != null) { bind_host = str(bind_env); }

server {
  host = bind_host;
  port = 18793;
  docroot = "web/dist";
}
run();
