// src/features.lume — lume language feature self-checks (public, neutral).
// Each feature has a runtime demo: feature_list() returns
// [{name, desc, demo, status}] where demo is the actual executed result
// (proof the feature works on the current lume-core). Imported by
// server.lume for /api/features.
//
// Language discipline (this project follows it): '/' is always float ·
// let is function-scoped (unique loop variable names) · list is reference
// semantics (push mutates in place) · print takes one arg + str() concat.

// ---- feature demos (each returns a result string) ----

// enum declarations (module top-level only — not allowed inside functions).
enum FShape { Cir(r: float) | Rect(w: float, h: float) }
enum FColor { Red | Green | Blue }
type FPoint = { x: int, y: int };

// ① static typing & inference: type annotations + let inference + int→float widening.
func demo_types(): string {
  let a: FPoint = { x: 3, y: 4 };
  let dx = a.x;               // inferred int
  let w: float = 7;           // int literal widens to float
  return "p=" + str(a) + " dx=" + str(dx) + " widened=" + str(w);
}

// ② enum + match (exhaustive·pattern binding·arm-scoped bindings).
func demo_enum(): string {
  let s = Cir(2.0);
  let area = match (s) { Cir(r) => 3.14 * r * r, Rect(w, h) => w * h };
  let name = match (s) { Cir(r) => "circle", Rect(w, h) => "rect" };
  let c: FColor = Green;
  let word = match (c) { Red => "stop", Green => "go", Blue => "cool" };
  return "area=" + str(area) + " " + name + " " + word;
}

// ③ higher-order + trailing closure: map/filter/reduce.
func demo_hof(): string {
  let xs = [1, 2, 3, 4, 5];
  let ys = map((x) => x * x, xs);                    // trailing closure
  let evens = filter((x) => x % 2 == 0, xs);
  let total = reduce((acc, x) => acc + x, xs, 0);
  return "sq=" + str(ys) + " evens=" + str(evens) + " sum=" + str(total);
}

// ④ range sequence.
func demo_range(): string {
  let r = range(1, 5);
  let acc: string = "";
  for (let i = 0; i < len(r); i = i + 1) {
    acc = acc + str(r[i]);
    if (i < len(r) - 1) { acc = acc + ","; }
  }
  return "range(1,5)=[" + acc + "] len=" + str(len(r));
}

// ⑤ Result + `?` error propagation.
func demo_result(): string {
  let ok_part: Result = _report_ok();
  let e: Result = _divide(1, 0);
  return get(ok_part, "ok", "?") + " err=" + str(get(e, "err", ""));
}

func _report_ok(): Result {
  let q: float = _divide(21, 7)?;
  return { ok: "q=" + str(q) };
}

func _divide(a: int, b: int): Result {
  if (b == 0) { return { err: "div by zero" }; }
  return { ok: a / b };
}

// ⑥ string cast & concat (str/int/float·map accessor).
func demo_string(): string {
  let acc = { name: "lume", n: "42", amt: 3.5 };
  let tag = "v" + str(acc, "n", "0");
  let amt: float = float(get(acc, "amt", 0.0));
  return tag + "|" + str(acc, "name", "") + "|" + str(amt);
}

// ⑦ module system: this file is a module (export funcs are importable).
func demo_module(): string {
  return "export func feature_list() cross-module usable (server.lume imports it)";
}

// ⑧ list reference semantics (measured): list is a mutable container·push
// appends in place and returns the same reference (not copy value semantics).
func demo_list_sem(): string {
  let a: int[] = [1, 2];
  let b: int[] = push(a, 3);
  return "a_after=" + str(a) + " b=" + str(b) + " shared=" + str(len(a) == len(b));
}

// ⑨ '/' is always float: integer division keeps the fraction.
func demo_float_div(): string {
  let r = 7 / 2;
  return "7/2=" + str(r) + " is_float=" + str(r > 3.0 and r < 4.0);
}

// ⑩ builtin HTTP server: server{} + run() capability (actually listening in server.lume).
func demo_server(): string {
  return "server { port/docroot } + run() builtin·callable from HTTP routes here";
}

// ⑪ builtin HTTP client: http_get (interpreter-only builtin·SSRF gate rejects
// private addresses). Note: the demo does NOT call http_get — it has no
// compiled-backend entry; the actual call runs on the interpreter (the
// server uses the interpreter) demonstrating the SSRF gate. This keeps the
// three-backend consistency intact.
func demo_http_get(): string {
  return "http_get(url, opts) interpreter builtin·SSRF gate rejects private addrs·compiled backends lack it (boundary)";
}

// ⑫ C kernel matmul (wall 3·three-backend shared·strict FP bit-exact).
func demo_matmul(): string {
  let A = [[1.0, 2.0], [3.0, 4.0]];
  let B = [[5.0, 6.0], [7.0, 8.0]];
  return "matmul=" + str(matmul(A, B));
}

// ---- collector ----

export func feature_list() {
  let out = [];
  out = push(out, { name: "static typing & inference", desc: "type annotations + let inference + int->float widening", demo: demo_types(), status: "ok" });
  out = push(out, { name: "enum + match", desc: "algebraic data types·exhaustive match·pattern binding", demo: demo_enum(), status: "ok" });
  out = push(out, { name: "higher-order + trailing closure", desc: "map/filter/reduce·trailing closures", demo: demo_hof(), status: "ok" });
  out = push(out, { name: "range", desc: "integer sequences·iteration", demo: demo_range(), status: "ok" });
  out = push(out, { name: "Result + ?", desc: "error propagation·? unwraps ok·err propagates", demo: demo_result(), status: "ok" });
  out = push(out, { name: "string cast & concat", desc: "str/int/float + map accessor", demo: demo_string(), status: "ok" });
  out = push(out, { name: "module import", desc: "import as alias·cross-module member calls", demo: demo_module(), status: "ok" });
  out = push(out, { name: "list reference semantics", desc: "list is a mutable container·push appends in place (measured·not value semantics)", demo: demo_list_sem(), status: "ok" });
  out = push(out, { name: "float division", desc: "'/' is always float·integer division keeps fraction", demo: demo_float_div(), status: "ok" });
  out = push(out, { name: "builtin HTTP server", desc: "server{} + run()·docroot static serving", demo: demo_server(), status: "ok" });
  out = push(out, { name: "builtin HTTP client", desc: "http_get·SSRF gate rejects private addresses", demo: demo_http_get(), status: "ok" });
  out = push(out, { name: "C kernel matmul", desc: "wall 3·three-backend bit-exact·12x", demo: demo_matmul(), status: "ok" });
  return out;
}
